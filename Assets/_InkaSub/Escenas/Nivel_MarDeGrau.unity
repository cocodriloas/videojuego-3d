  botonNormal: {fileID: 21300000, guid: 310a47a9c095dfd4aada56146998df38, type: 3}
  botonResaltado: {fileID: 21300000, guid: 908e3b9033fbf9a45a2cb907a8b4e0d9, type: 3}
  botonPresionado: {fileID: 21300000, guid: 39e2cac43537bc04ba14bd5eb3d30f6f, type: 3}
  marcoPanel: {fileID: 21300000, guid: 498ddb4065c71994f821b614f74aade4, type: 3}
  rielDeslizador: {fileID: 21300000, guid: ab79743935d209342b37f4e61d8c512d, type: 3}
  perillaDeslizador: {fileID: 21300000, guid: ef962f8ffc10f1446890517a1cdb06d1, type: 3}
  datosAlPerder:
  - "Una botella de pl\xE1stico puede tardar unos 450 a\xF1os en degradarse en el
    mar."
  - "La bacteria Ideonella sakaiensis, descubierta en Jap\xF3n en 2016, puede descomponer
    el pl\xE1stico PET."
  - "Las redes de pesca abandonadas (redes fantasma) siguen atrapando animales durante
    a\xF1os."
  - "El ODS 14 busca conservar y usar de forma sostenible los oc\xE9anos y los recursos
    marinos."
  - "Los micropl\xE1sticos ya se encuentran en peces, aves y hasta en el agua que
    bebemos."
